# Copy this file to .env and replace the placeholder values.
#
#   cp .env.sample .env
#
# .env is gitignored. Never commit real keys.
#
# Every variable below maps to a field in src/sparkstory/config.py.
# Variables not declared there are silently ignored (extra="ignore"), so if you
# add one here, add the matching field too.

# --- Required ------------------------------------------------------------
# Google AI Studio key, used for Gemini text generation (and, from the
# illustration session onward, image generation).
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyExample000000000000000000000000000

# --- Optional: second provider -------------------------------------------
# xAI key, used by the grok-* entries. Only needed if a *_MODEL below names one.
# Worth having: when Gemini returns 503 UNAVAILABLE, no Gemini model helps, and
# a second provider is the only thing that does.
# Get one at: https://console.x.ai/
XAI_API_KEY=xai-Example00000000000000000000000000000

# --- Model selection ----------------------------------------------------
# One per agent, each a key of `llm_configs` in config.py. Separate variables so
# that giving the writer a stronger (more expensive) model than the planner is a
# config change rather than a code change.
#
# Available entries (keys of `llm_configs` in config.py):
#   gemini-3.5-flash   Gemini, newest. Returns 503 UNAVAILABLE under load.
#   gemini-2.5-pro     Gemini, slowest and most expensive.
#   grok-4             xAI. A different provider, so Gemini congestion does not
#                      affect it. Needs XAI_API_KEY.
#   grok-3-mini        xAI, smaller and cheaper.
PLANNER_MODEL=gemini-3.5-flash
PLOT_MODEL=gemini-3.5-flash
WRITER_MODEL=gemini-3.5-flash
RESEARCHER_MODEL=gemini-3.5-flash
OUTLINE_CRITIC_MODEL=gemini-3.5-flash-critic
PROSE_CRITIC_MODEL=gemini-3.5-flash-critic

# The all-Grok equivalent, if Gemini is returning 503:
#   PLANNER_MODEL=grok-3-mini
#   PLOT_MODEL=grok-3-mini
#   WRITER_MODEL=grok-3-mini
#   RESEARCHER_MODEL=grok-3-mini-researcher
#   OUTLINE_CRITIC_MODEL=grok-3-mini-critic
#   PROSE_CRITIC_MODEL=grok-3-mini-critic

# --- Research and retrieval ----------------------------------------------
# The embedding model runs locally: no key, no network at query time. Build the
# index once before a grounded run:
#
#   uv run python scripts/ingest_knowledge.py
#
# MAX_RESEARCH_STEPS=0 skips research entirely, which is how you compare a
# grounded run against an ungrounded one on the same premise.
EMBEDDING_MODEL=potion-base-8M
MAX_RESEARCH_STEPS=4
RETRIEVAL_TOP_K=5
# Defaults to <repo>/data/knowledge. Only set this to move the index elsewhere.
# KNOWLEDGE_ROOT=/absolute/path/to/knowledge

# --- Logging -------------------------------------------------------------
# LOG_LEVEL controls SparkStory's own modules.
# LOG_LEVEL_DEPENDENCIES controls noisy third-party libraries (httpx, google,
# fastmcp, ...) separately, so request spam does not drown out our logs.
LOG_LEVEL=INFO
LOG_LEVEL_DEPENDENCIES=WARNING
