# --- Secrets -------------------------------------------------------------
# .env holds real API keys and must never be committed.
# .env.sample IS committed and documents the required variable names.
.env
.env.local

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Virtual environment -------------------------------------------------
# Note: .venv/ is ignored but uv.lock is COMMITTED. The lockfile is the
# reproducibility record that lets anyone rebuild identical dependencies;
# the virtualenv is a machine-specific build artifact.
.venv/

# --- Local MCP client config --------------------------------------------
# May contain API keys in its "env" block. .mcp.json.sample is committed.
.mcp.json

# --- Generated runs ------------------------------------------------------
# scripts/write_one_story.py writes one directory per run here: the brief, each
# stage's output, the book, and the log. Ignored for two reasons: every run holds
# a real child's name, which is personal data about a minor, and generated stories
# would bloat the repository. To keep one as a sample, copy it somewhere tracked.
outputs/

# --- Local data ----------------------------------------------------------
# Reserved for real persistence (the canon store). Not the same thing as
# outputs/, which is debugging output that can be deleted at any time.
data/

# --- OS / editor ---------------------------------------------------------
.DS_Store
*.swp
